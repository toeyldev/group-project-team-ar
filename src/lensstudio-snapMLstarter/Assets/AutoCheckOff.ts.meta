    - '// @input float minReach = 15 {"hint":"Closest a hand joint can be to the camera (cm) and still count as touching"}'
    - '// @input float maxReach = 75 {"hint":"Farthest a hand joint can be from the camera (cm) and still count as touching"}'
    - '// @input float boxPadding = 0.05 {"hint":"Extra margin around each detection box, in camera UV units", "widget":"slider", "min":0, "max":0.2, "step":0.01}'
    - '// @input float palmHoldSeconds = 0.5 {"hint":"Seconds an open palm must face the glasses to cancel", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @input float openHandLength = 12 {"hint":"Minimum wrist-to-middle-fingertip distance (cm) for the hand to count as open"}'
    - '// @input float cooldownSeconds = 10 {"hint":"Seconds before a cancelled item can trigger again"}'
    - '// @input bool debugLogging {"hint":"Log touches and countdown changes"}'

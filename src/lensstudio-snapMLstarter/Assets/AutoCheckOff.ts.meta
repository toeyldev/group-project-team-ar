    - '// @input bool enabledAtStart = true {"hint":"Whether auto check-off is on when the lens starts"}'
    - '// @input float bufferSeconds = 5 {"hint":"Seconds the user has to cancel before the item is checked off", "widget":"slider", "min":1, "max":10, "step":0.5}'

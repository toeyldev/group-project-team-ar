  InputLines:
    - '// @input AssignableType mlSpatializer {"hint":"MLSpatializer that emits detection updates"}'
    - '// @input AssignableType_1 pinholeCapture {"hint":"PinholeCapture used to project hand joints into the camera image"}'
    - '// @input AssignableType_2 boxVisualizer {"hint":"BoundingBoxVisualizer, used for its detection-to-camera UV mapping"}'
